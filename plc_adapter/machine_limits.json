{
  "_meta": {
    "schema": "skillforge_machine_limits_v1",
    "description": "What SkillForge may read and change on each machine. Tag limits drive trend prediction; setpoints and actions bound every write. Safety interlocks in the PLC itself are never touched.",
    "facility": "PT Karawang Precision Manufacturing"
  },
  "defaults": {
    "write_enabled": true,
    "tags": {
      "motor_temp_celsius":         {"label": "Suhu motor spindel", "unit": "°C",   "warning": 85.0, "critical": 95.0, "direction": "rising"},
      "spindle_vibration_mm_per_s": {"label": "Vibrasi spindel",    "unit": "mm/s", "warning": 5.0,  "critical": 8.0,  "direction": "rising"},
      "coolant_pressure_bar":       {"label": "Tekanan coolant",    "unit": "bar",  "warning": 2.5,  "critical": 2.0,  "direction": "falling"}
    },
    "setpoints": {
      "feed_override_percent":          {"label": "Feed override",          "unit": "%", "min": 50.0, "max": 100.0, "max_step": 50.0},
      "spindle_speed_override_percent": {"label": "Spindle speed override", "unit": "%", "min": 60.0, "max": 100.0, "max_step": 40.0},
      "feed_hold":                      {"label": "Feed hold",              "unit": "",  "min": 0.0,  "max": 1.0,   "max_step": 1.0}
    },
    "actions": {
      "reduce_feed_50": {
        "label": "Turunkan feed override ke 50% agar motor spindel mendingin",
        "tag": "feed_override_percent", "value": 50.0,
        "alarm_codes": ["ALM-410", "Alarm 108", "SP1241"],
        "metrics": ["motor_temp_celsius"],
        "autonomous": true
      },
      "reduce_spindle_60": {
        "label": "Turunkan spindle speed override ke 60% untuk menahan vibrasi bearing",
        "tag": "spindle_speed_override_percent", "value": 60.0,
        "alarm_codes": ["ALM-162"],
        "metrics": ["spindle_vibration_mm_per_s"],
        "autonomous": false
      },
      "feed_hold": {
        "label": "Feed hold: hentikan pemakanan sampai tekanan coolant pulih",
        "tag": "feed_hold", "value": 1.0,
        "alarm_codes": ["Alarm 970", "ALM-441"],
        "metrics": ["coolant_pressure_bar"],
        "autonomous": false
      }
    }
  },
  "autonomy": {
    "description": "Limited autonomy: only actions marked autonomous, only when a supervisor has switched it on, only in the safe direction (a reduction), and with every pre-action check passing.",
    "default_enabled": false
  },
  "machines": {
    "CNC-01": {},
    "CNC-02": {},
    "CNC-03": {
      "write_enabled": false,
      "note": "Fanuc controller not yet commissioned for remote setpoint writes; read-only."
    },
    "CNC-04": {},
    "CNC-05": {}
  }
}
