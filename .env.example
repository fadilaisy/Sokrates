
# SkillForge Environment Configuration
# Copy this file to .env and fill in your own values. .env is gitignored:
# real keys go there, never in this file.

# ── SAP AI Core (the only LLM provider) ──────────────────────────────────────────
# All four values come from your AI Core service key (key broker JSON).
# Hackathon teams: GET https://hackathon-keybroker.cfapps.ap10.hana.ondemand.com/ai-core/<team>-key
AICORE_AUTH_URL=https://your-subaccount.authentication.region.hana.ondemand.com
AICORE_CLIENT_ID=your_clientid_here
AICORE_CLIENT_SECRET=your_clientsecret_here
AI_API_URL=https://api.ai.your-region.aws.ml.hana.ondemand.com
AICORE_DEPLOYMENT_ID=d1a82575de60e02a
AICORE_RESOURCE_GROUP=default

# Orchestration deployment: one endpoint serving dozens of chat models, chosen
# per call via model_name — which MUST be a plain string (an object returns
# HTTP 400). This is the default path; set AICORE_ORCHESTRATION_ID= (empty) to
# fall back to the direct deployment above.
AICORE_ORCHESTRATION_ID=d8c092efb8980093
AICORE_MODEL_NAME=gpt-5.4
# Tried in order on the same tenant when the main model fails. Tenant names
# differ from the public vendor names, and accepted ≠ callable: some names fail
# with "version latest not found" — smoke-test a new name with
# scripts/aicore_check.py before switching. Checked 2026-10-26 as working:
# gpt-5.4, gpt-5, gpt-4.1, anthropic--claude-4.5-sonnet, anthropic--claude-4.5-haiku,
# anthropic--claude-4.6-sonnet, amazon--nova-pro.
AICORE_FALLBACK_MODELS=anthropic--claude-4.5-sonnet
# Model that plans agent runs (backend/agent_run.py); falls back like the rest.
AGENT_MODEL=anthropic--claude-4.5-sonnet
# Background AI calls per minute (telemetry, agent) are capped below this.
# LLM_RPM=30
PORT=8000

# Browser origins allowed to call the API (comma-separated). Default is the
# local Vite dev origin only; production is served same-origin via Caddy.
# Set CORS_ORIGINS=* to allow all origins (credentials are dropped then).
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Frontend on another host (Vercel): list its URL in CORS_ORIGINS, or match every
# preview deploy with a regex.
# CORS_ORIGIN_REGEX=https://sokrates-[a-z0-9-]+-fadilaisy\.vercel\.app

# ── SAP S/4HANA (erp_adapter/s4hana.py) ─────────────────────────────────────
# Real production orders from S/4HANA, laid over the demo shop floor. Without
# these the backend uses erp_adapter/mock_sap_state.json as is.
# Free sandbox: log in at https://api.sap.com, copy your API key.
# SAP_API_KEY=
# Real tenant instead: OData root of API_PRODUCTION_ORDER_2_SRV + basic auth.
# SAP_API_BASE=https://<host>/sap/opu/odata/sap/API_PRODUCTION_ORDER_2_SRV
# SAP_USER=
# SAP_PASSWORD=

# ── RAG (rag/) ───────────────────────────────────────────────────────────────
# Generative LLM for cited answers. auto = AI Core first (with its fallback
# models), then the public Anthropic API below if a key is set.
RAG_GEN_PROVIDER=auto
ANTHROPIC_API_KEY=
# Public Anthropic API model name only (AI Core uses names like
# anthropic--claude-4.5-haiku instead).
CLAUDE_MODEL=claude-haiku-4-5
# Where the SQLite index and uploaded files live (default: ./rag_data)
# RAG_DATA_DIR=./rag_data
# Tesseract languages (install: apt install tesseract-ocr-ind / brew install tesseract-lang)
RAG_OCR_LANGS=ind+eng

# ── Runtime data paths ───────────────────────────────────────────────────────
# Hash-chained audit log and maintenance ledger (default: repo root). The test
# suite points these at a temp dir, so pytest runs never touch real logs.
# AUDIT_LEDGER_PATH=./audit_ledger.jsonl
# MAINTENANCE_LEDGER_PATH=./maintenance_ledger.jsonl

# ── PLC (/ws/plc) — see docs/PLC.md ─────────────────────────────────────────
# Driver: "simulated" (default) or "opcua" for real controllers. Any other value stops startup.
# PLC_DRIVER=simulated
# Both required with opcua. Copy config/opcua_map.example.json to config/opcua_map.json first.
# PLC_OPCUA_ENDPOINT=opc.tcp://192.168.10.20:4840
# PLC_OPCUA_MAP=./config/opcua_map.json
# Setpoint writes (approvals and limited autonomy). Default: on for the simulator, off for opcua.
# PLC_WRITES_ENABLED=false
# Simulator: seconds a fault scenario takes to creep from normal to its fault value.
# PLC_RAMP_S=120
# Seconds between PLC scans pushed to the cockpit.
# PLC_SCAN_S=1.0
# Predictions further out than this many seconds are not shown.
# PLC_PREDICT_HORIZON_S=600
