
# SkillForge Environment Configuration
# Copy this file to .env and set your Google Gemini API Key

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
PORT=8000

# ── RAG (rag/) ───────────────────────────────────────────────────────────────
# Generative LLM for cited answers. auto = Gemini first, Claude Haiku 4.5 as fallback.
RAG_GEN_PROVIDER=auto
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5
# Where the SQLite index and uploaded files live (default: ./rag_data)
# RAG_DATA_DIR=./rag_data
# Tesseract languages (install: apt install tesseract-ocr-ind / brew install tesseract-lang)
RAG_OCR_LANGS=ind+eng
